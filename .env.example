# Copy this file to .env and adjust values for your machine.

# launchd label. Keep it unique per user/project.
LABEL=com.stoker.ai-window

# Space-separated list of old launchd labels to remove during install.
# LEGACY_LABELS=""

# Schedule times in HH:MM format, comma-separated.
SCHEDULE_TIMES="07:00,12:00,17:00,22:00"

# Which tools to activate: all, claude, or codex.
ACTIVATION_TOOL=all

# The low-cost prompt sent to Claude during activation.
ACTIVATION_PROMPT="Reply exactly READY. Do not inspect files, run tools, or modify anything."

# ── Headless authentication (recommended for the scheduler) ──────────────────
# By default the scheduled `claude -p` run reuses your interactive Claude Code
# login from the macOS Keychain. That credential is short-lived and gets rotated
# whenever your interactive session refreshes it, so an unattended run can fail
# with "401 Invalid authentication credentials" until you log in again.
# Mint a long-lived token once with `claude setup-token` and paste it here to make
# the scheduler self-sufficient. It authenticates as — and bills against — your
# existing Claude subscription (no extra API charges). Keep .env out of git.
# CLAUDE_CODE_OAUTH_TOKEN="sk-ant-oat01-..."

# Codex model used for activation. Use "default" to let Codex CLI choose.
CODEX_MODEL=gpt-5.6-luna

# Codex uses a tiny read-only probe task by default. The bash engine expands
# ${ROOT_DIR} when it sources .env; keep it literal here (do not pre-expand).
CODEX_WORK_DIR="${ROOT_DIR}/codex-probe"
CODEX_ACTIVATION_PROMPT="Read only ./probe.py. Do not inspect any other path. Do not modify files. In two short bullets, explain what activation_probe_score returns for SAMPLE_EVENTS, then end with READY."

# Per-tool timeout in seconds.
TIMEOUT_SECONDS=120

# Set to 0 if you only want activation logs and per-run usage, not quota snapshots.
ENABLE_STATUS_SNAPSHOTS=1

# Check quota before sending a prompt. If a known five-hour or weekly quota is
# exhausted, the run is skipped and recorded instead of calling the CLI.
ENABLE_QUOTA_PREFLIGHT=1

# Where Claude quota snapshots come from:
#   cache  — read the oh-my-claudecode plugin's local usage cache. No network, no
#            credentials; data is the plugin's last-known quota (each snapshot row
#            carries cache_age_seconds so consumers can judge freshness).
#   native — query Anthropic's usage endpoint with a READ-ONLY copy of the Claude
#            Code Keychain token. No omc needed. Skipped whenever the token has
#            expired — it never refreshes anything, so it can't log your
#            interactive session out. After enabling, run `./install.sh quota`
#            once in a terminal and click "Always Allow" if Keychain asks, so
#            scheduled runs can read the credential.
#   omc    — force a live `omc wait status` query. In an unattended run this reads
#            the shared macOS Keychain OAuth credential and, once the access token
#            has expired, consumes its refresh token without being able to persist
#            the replacement — logging your interactive Claude Code session out.
CLAUDE_STATUS_SOURCE=cache

# Usage-cache path override (rarely needed; honors CLAUDE_CONFIG_DIR by default).
# CLAUDE_USAGE_CACHE_FILE="${HOME}/.claude/plugins/oh-my-claudecode/.usage-cache-anthropic.json"

# User-Agent for the native Claude usage request. Without a claude-code-shaped UA the
# endpoint routes you into an aggressively rate-limited bucket (persistent 429). Only
# used when CLAUDE_STATUS_SOURCE=native.
# CLAUDE_USAGE_USER_AGENT="claude-code/0.3.5"

# Where Codex quota comes from:
#   app-server — (default) spawn `codex app-server` over JSON-RPC. Needs node + codex.
#   native     — read the ChatGPT usage endpoint over HTTP, read-only. Reads the access
#                token from ~/.codex/auth.json and NEVER refreshes it (no logout side
#                effect); needs neither node nor a running app-server. On plans that
#                surface plan tier + credit balance, native shows both.
CODEX_STATUS_SOURCE=app-server

# Codex native overrides (only used when CODEX_STATUS_SOURCE=native).
# CODEX_AUTH_FILE="${HOME}/.codex/auth.json"
# CODEX_USAGE_API_URL="https://chatgpt.com/backend-api/wham/usage"
# CODEX_USAGE_USER_AGENT="codex_cli_rs/0.144.6 (darwin)"

# What to do when quota cannot be checked: allow or skip.
QUOTA_PREFLIGHT_ON_UNKNOWN=allow

# Skip when remaining quota is at or below this percentage.
QUOTA_EXHAUSTED_THRESHOLD_PERCENT=0

# Weekly-only Codex accounts (no 5-hour window): 1 skips the Codex prompt while the
# 7-day window is already running (reason window_already_active) and only sends it
# when the window is idle, since another prompt can't start a new window. Has no
# effect when a 5-hour window is reported. 0 always sends. Needs ENABLE_QUOTA_PREFLIGHT=1.
CODEX_ACTIVATE_ONLY_WHEN_IDLE=1

# Prevent sleep while real activation is running. Use off, during, or always.
# "during" and "always" both keep scheduled CLI activations awake while they run.
# The menu bar app also keeps the Mac awake while the app is open when set to always.
KEEP_AWAKE_MODE=off
KEEP_AWAKE_SECONDS=900

# Override binary paths only when auto-discovery fails.
# CLAUDE_BIN="${HOME}/.local/bin/claude"
# CODEX_BIN=/opt/homebrew/bin/codex
# JQ_BIN=/usr/bin/jq
# NODE_BIN=/opt/homebrew/bin/node
# OMC_BIN=/opt/homebrew/bin/omc

# PATH used by launchd and the runner.
# PATH_VALUE="${HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
